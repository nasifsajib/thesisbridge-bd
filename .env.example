# ============================================================================
# ThesisBridge BD - environment variables
# ============================================================================
# 1. Copy this file and name the copy:  .env
# 2. Fill in the three values from your Supabase project:
#    Supabase dashboard -> Project Settings -> API
# 3. Never commit the real .env file to Git.
# ============================================================================

# The project URL, for example: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The "anon / public" key. Used only for Supabase Auth calls.
SUPABASE_ANON_KEY=

# The "service_role" key. Used for database queries.
# SECRET: keep it on the server only, never in JavaScript or HTML.
SUPABASE_SERVICE_ROLE_KEY=

# Which websites may call this API from a browser.
# "*" is fine for local development. On Vercel you can leave it as "*"
# because the frontend and API share the same domain.
CORS_ORIGINS=*
